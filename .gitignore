# Obsidian Vault
# Ignore all .obsidian/ config dirs (workspace state, themes, cache — not content)
**/.obsidian/
.trash/

# Digitizer Intermediate Page Renders & Manifests (from slide-digitizer / handnote-digitizer)
# (Cropped diagrams and frames are kept; raw full-page extraction renders are ignored)
**/*_Pages/
**/pdf/pages/
**/manifest.json

# Pipeline & Temporary Files
**/temp_audio.*
**/progress.json
**/*.tmp
**/*.part
**/*.bak
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Settings
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Python & Environment
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# Local Agent / Scratch Files
.agents/
.gemini/
scratch/
writing_guideline.md
AGENTS.md
.agentsignore

# LaTeX Build Artifacts (circuit diagram sources and intermediate outputs)
**/*.aux
**/*.log
**/*.tex
**/diagrams/*.pdf

# Intermediate Diagram Render Artifacts
**/*_raw-*.png

# Copyrighted Source Textbook PDFs (never push to GitHub)
Books/**/*.pdf